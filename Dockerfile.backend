# Panorama Backend
#
# Multi-stage build:
#   1. ui-builder  — Node.js, builds plugin UIs (Module Federation remotes)
#   2. builder     — Rust, compiles WASM plugins + server, packages .panoapp
#   3. runtime     — slim Debian, production image

# ── Stage 1: Build plugin UIs ────────────────────────────────────────────────
FROM node:22-slim AS ui-builder

WORKDIR /build
COPY crates/ ./crates/

# Build each plugin's UI if it has a package.json + vite.config.ts
RUN for dir in crates/panorama-app-*/ui/; do \
      if [ -f "$dir/package.json" ] && [ -f "$dir/vite.config.ts" ]; then \
        echo "=== Building UI in $dir ==="; \
        (cd "$dir" && npm ci && npm run build); \
      fi \
    done

# ── Stage 2: Build WASM plugins + server ─────────────────────────────────────
FROM rust:1-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-wasip1

WORKDIR /build

# Copy Rust sources
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/

# Build WASM plugins
RUN cargo build --release -p wasm-plugins --target wasm32-wasip1

# Build server
RUN cargo build --release -p panorama-server

# Copy pre-built plugin UIs from ui-builder
COPY --from=ui-builder /build/crates/ ./crates/
COPY scripts/package-panoapp.py /tmp/package-panoapp.py

# Package .panoapp files (manifest + WASM + UI)
RUN mkdir -p /panoapp && \
    for crate in journal wakatime grafana trips beli subsonic files; do \
      m="crates/panorama-app-${crate}/manifest.json"; \
      w="target/wasm32-wasip1/release/${crate}.wasm"; \
      ui="crates/panorama-app-${crate}/ui/dist"; \
      ui_arg=""; \
      [ -f "$m" ] && [ -f "$w" ] || continue; \
      [ -d "$ui" ] && ui_arg="--ui-dir $ui"; \
      python3 /tmp/package-panoapp.py "$m" "$w" /panoapp $ui_arg; \
    done

# ── Stage 3: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils && rm -rf /var/lib/apt/lists/*

# Install wasmtime CLI
RUN curl -fsSL https://github.com/bytecodealliance/wasmtime/releases/download/v29.0.1/wasmtime-v29.0.1-x86_64-linux.tar.xz \
    | tar -xJ --strip-components=1 -C /usr/local/bin wasmtime-v29.0.1-x86_64-linux/wasmtime \
    && chmod +x /usr/local/bin/wasmtime \
    && wasmtime --version

COPY --from=builder /build/target/release/panorama-server /usr/local/bin/panorama-server
ENV PANORAMA_DATA_DIR=/var/lib/panorama/data
ENV PANORAMA_LISTEN=0.0.0.0:3000

# Plugins stored outside data dir so volume mount doesn't hide them
COPY --from=builder /panoapp /var/lib/panorama/plugins

# Entrypoint: seed plugins into volume on first run
RUN printf '#!/bin/sh\nmkdir -p %s/plugins\ncp -n /var/lib/panorama/plugins/* %s/plugins/ 2>/dev/null || true\nexec panorama-server\n' "$PANORAMA_DATA_DIR" "$PANORAMA_DATA_DIR" > /entrypoint.sh && chmod +x /entrypoint.sh

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --retries=5 --start-period=10s \
    CMD curl -f http://localhost:3000/api/plugins || exit 1

CMD ["/entrypoint.sh"]
