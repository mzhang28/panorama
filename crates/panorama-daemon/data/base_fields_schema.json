{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"properties": {
		"fields": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"fq_field_name",
					"relation_name",
					"relation_field_name",
					"type"
				],
				"properties": {
					"fq_field_name": {
						"type": "string"
					},
					"relation_name": {
						"type": "string"
					},
					"relation_field_name": {
						"type": "string"
					},
					"type": {
						"type": "string"
					},
					"is_fts_enabled": {
						"type": "boolean"
					}
				}
			}
		}
	},
	"title": "Base Panorama Fields"
}
