{
  "name": "panorama-app-wakatime",
  "targets": {
    "build-wasm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "RUSTFLAGS=\"-C link-arg=--allow-undefined\" cargo build -p panorama-app-wakatime --target wasm32-wasip1"
      },
      "configurations": {
        "development": {
          "command": "RUSTFLAGS=\"-C link-arg=--allow-undefined\" cargo build -p panorama-app-wakatime --target wasm32-wasip1"
        },
        "release": {
          "command": "RUSTFLAGS=\"-C link-arg=--allow-undefined\" cargo build --release -p panorama-app-wakatime --target wasm32-wasip1"
        }
      },
      "defaultConfiguration": "development",
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{workspaceRoot}/crates/panorama-core/src/**/*",
        "{workspaceRoot}/crates/wasm-types/src/**/*",
        "{workspaceRoot}/Cargo.lock"
      ],
      "outputs": [
        "{workspaceRoot}/target/wasm32-wasip1/debug/wakatime.wasm",
        "{workspaceRoot}/target/wasm32-wasip1/release/wakatime.wasm"
      ],
      "cache": true
    },
    "package-panoapp": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/package-panoapp.ts crates/panorama-app-wakatime/manifest.json target/wasm32-wasip1/debug/wakatime.wasm dist/panoapp --ui-dir crates/panorama-app-wakatime/ui/dist"
      },
      "configurations": {
        "development": {
          "command": "bun scripts/package-panoapp.ts crates/panorama-app-wakatime/manifest.json target/wasm32-wasip1/debug/wakatime.wasm dist/panoapp --ui-dir crates/panorama-app-wakatime/ui/dist"
        },
        "release": {
          "command": "bun scripts/package-panoapp.ts crates/panorama-app-wakatime/manifest.json target/wasm32-wasip1/release/wakatime.wasm dist/panoapp --ui-dir crates/panorama-app-wakatime/ui/dist"
        }
      },
      "defaultConfiguration": "development",
      "dependsOn": [
        "build-wasm",
        "panorama-plugin-wakatime-ui:build"
      ],
      "inputs": [
        "{projectRoot}/manifest.json",
        "{workspaceRoot}/scripts/package-panoapp.ts",
        "{workspaceRoot}/target/wasm32-wasip1/debug/wakatime.wasm",
        "{workspaceRoot}/target/wasm32-wasip1/release/wakatime.wasm",
        "{projectRoot}/ui/dist/**/*"
      ],
      "outputs": [
        "{workspaceRoot}/dist/panoapp/wakatime.panoapp"
      ],
      "cache": true
    }
  }
}
