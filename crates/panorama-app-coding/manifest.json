{
  "manifest_version": 1,
  "id": "io.mzhang.panorama.coding",
  "name": "Coding Activity",
  "version": "0.3.0",
  "description": "Full Coding Activity API-compatible heartbeat collection with stats, durations, leaderboards, and WakaTime compatibility",
  "author": "Panorama",
  "schemas": [
    {
      "name": "Heartbeat",
      "version": { "major": 2, "minor": 1 },
      "schema_mode": "Preferred",
      "fields": [
        {
          "name": "node_time",
          "namespace": "system",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "When the heartbeat was recorded",
          "computed": null
        },
        {
          "name": "entity",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "File path, domain, or app identifier",
          "computed": null
        },
        {
          "name": "type",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "Entity type: file, app, url, or domain",
          "computed": null
        },
        {
          "name": "category",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Activity category (coding, building, debugging, etc.)",
          "computed": null
        },
        {
          "name": "time",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "UNIX epoch timestamp with fractional seconds",
          "computed": null
        },
        {
          "name": "project",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Project name",
          "computed": null
        },
        {
          "name": "project_root_count",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Number of folders in project root path",
          "computed": null
        },
        {
          "name": "branch",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Git branch name",
          "computed": null
        },
        {
          "name": "language",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Programming language name",
          "computed": null
        },
        {
          "name": "dependencies",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Comma-separated dependency list",
          "computed": null
        },
        {
          "name": "machine_name_id",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Unique machine identifier",
          "computed": null
        },
        {
          "name": "editor",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Editor/IDE name",
          "computed": null
        },
        {
          "name": "operating_system",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Operating system name",
          "computed": null
        },
        {
          "name": "user_agent",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Raw User-Agent string",
          "computed": null
        },
        {
          "name": "hash",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Deduplication hash",
          "computed": null
        },
        {
          "name": "origin",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Source of the heartbeat (e.g. wakatime)",
          "computed": null
        },
        {
          "name": "ai_line_changes",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Lines added/removed by GenAI since last heartbeat",
          "computed": null
        },
        {
          "name": "human_line_changes",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Lines added/removed by manual typing since last heartbeat",
          "computed": null
        },
        {
          "name": "ai_session",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "AI session identifier",
          "computed": null
        },
        {
          "name": "ai_input_tokens",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "User input tokens consumed since last heartbeat",
          "computed": null
        },
        {
          "name": "ai_output_tokens",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Model output tokens consumed since last heartbeat",
          "computed": null
        },
        {
          "name": "ai_prompt_length",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Prompt characters typed to AI since last heartbeat",
          "computed": null
        },
        {
          "name": "ai_subscription_plan",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "GenAI tool subscription plan tier",
          "computed": null
        },
        {
          "name": "line_additions",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Lines added since last heartbeat",
          "computed": null
        },
        {
          "name": "line_deletions",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Lines deleted since last heartbeat",
          "computed": null
        },
        {
          "name": "lines",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Total lines in the entity file",
          "computed": null
        },
        {
          "name": "lineno",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Current cursor line number (1-based)",
          "computed": null
        },
        {
          "name": "cursorpos",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Current cursor column position (1-based)",
          "computed": null
        },
        {
          "name": "is_write",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Whether this heartbeat was triggered by a write",
          "computed": null
        },
        {
          "name": "duration",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Duration in seconds since previous heartbeat (computed)",
          "computed": null
        },
        {
          "name": "is_ai_generated",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Whether this heartbeat involved AI code generation (computed)",
          "computed": null
        }
      ]
    },
    {
      "name": "Duration",
      "version": { "major": 1, "minor": 0 },
      "schema_mode": "Preferred",
      "fields": [
        {
          "name": "node_time",
          "namespace": "system",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "Start time of the coding session",
          "computed": null
        },
        {
          "name": "node_end_time",
          "namespace": "system",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "End time of the coding session",
          "computed": null
        },
        {
          "name": "entity",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "Primary entity (file/domain)",
          "computed": null
        },
        {
          "name": "project",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Project name",
          "computed": null
        },
        {
          "name": "language",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Programming language",
          "computed": null
        },
        {
          "name": "category",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Activity category",
          "computed": null
        },
        {
          "name": "duration_seconds",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "Total duration in seconds",
          "computed": null
        },
        {
          "name": "heartbeat_count",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Number of heartbeats in this session",
          "computed": null
        },
        {
          "name": "machine_name_id",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Machine that produced this session",
          "computed": null
        }
      ]
    },
    {
      "name": "DailySummary",
      "version": { "major": 1, "minor": 0 },
      "schema_mode": "Preferred",
      "fields": [
        {
          "name": "node_time",
          "namespace": "system",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "The date this summary covers",
          "computed": null
        },
        {
          "name": "date",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "ISO date string (YYYY-MM-DD)",
          "computed": null
        },
        {
          "name": "project",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Project name",
          "computed": null
        },
        {
          "name": "language",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Programming language",
          "computed": null
        },
        {
          "name": "entity",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "File path / entity",
          "computed": null
        },
        {
          "name": "category",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Activity category",
          "computed": null
        },
        {
          "name": "total_seconds",
          "namespace": "coding",
          "required": true,
          "field_type": null,
          "default": null,
          "description": "Total coding seconds for this dimension",
          "computed": null
        },
        {
          "name": "heartbeat_count",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Number of heartbeats",
          "computed": null
        },
        {
          "name": "session_count",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Number of coding sessions",
          "computed": null
        },
        {
          "name": "ai_seconds",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Seconds involving AI-generated code",
          "computed": null
        },
        {
          "name": "lines_added",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Total human lines added",
          "computed": null
        },
        {
          "name": "lines_removed",
          "namespace": "coding",
          "required": false,
          "field_type": null,
          "default": null,
          "description": "Total human lines removed",
          "computed": null
        }
      ]
    }
  ],
  "http_endpoints": [
    {
      "method": "POST",
      "path": "/users/current/heartbeats",
      "description": "Receive a single heartbeat"
    },
    {
      "method": "POST",
      "path": "/users/current/heartbeats.bulk",
      "description": "Receive bulk heartbeats (max 25)"
    },
    {
      "method": "GET",
      "path": "/users/current/heartbeats",
      "description": "Get heartbeats for a date"
    },
    {
      "method": "GET",
      "path": "/users/current/durations",
      "description": "Get durations for a date"
    },
    {
      "method": "DELETE",
      "path": "/users/current/heartbeats.bulk",
      "description": "Delete heartbeats for a date"
    },
    {
      "method": "POST",
      "path": "/heartbeat",
      "description": "Receive a single heartbeat (shorthand)"
    },
    {
      "method": "POST",
      "path": "/heartbeats",
      "description": "Receive bulk heartbeats (shorthand, max 25)"
    },
    {
      "method": "GET",
      "path": "/heartbeats",
      "description": "Get heartbeats for a date (shorthand)"
    },
    {
      "method": "GET",
      "path": "/durations",
      "description": "Get durations for a date (shorthand)"
    },
    {
      "method": "GET",
      "path": "/stats",
      "description": "Multi-dimensional stats: leaderboard, timeseries, sums"
    },
    {
      "method": "POST",
      "path": "/stats",
      "description": "Multi-dimensional stats with JSON query body"
    },
    {
      "method": "GET",
      "path": "/summaries",
      "description": "Get daily summaries"
    },

    {
      "method": "POST",
      "path": "/users/{user}/heartbeats",
      "description": "WakaTime compat: receive a single heartbeat"
    },
    {
      "method": "POST",
      "path": "/users/{user}/heartbeats.bulk",
      "description": "WakaTime compat: receive bulk heartbeats"
    },
    {
      "method": "POST",
      "path": "/v1/users/{user}/heartbeats",
      "description": "WakaTime compat v1: receive a single heartbeat"
    },
    {
      "method": "POST",
      "path": "/v1/users/{user}/heartbeats.bulk",
      "description": "WakaTime compat v1: receive bulk heartbeats"
    },
    {
      "method": "POST",
      "path": "/compat/wakatime/v1/users/{user}/heartbeats",
      "description": "WakaTime compat v1: receive a single heartbeat"
    },
    {
      "method": "POST",
      "path": "/compat/wakatime/v1/users/{user}/heartbeats.bulk",
      "description": "WakaTime compat v1: receive bulk heartbeats"
    },

    {
      "method": "GET",
      "path": "/users/{user}/stats/{range}",
      "description": "WakaTime compat: get stats for a range"
    },
    {
      "method": "GET",
      "path": "/users/{user}/stats",
      "description": "WakaTime compat: get stats (auto range)"
    },
    {
      "method": "GET",
      "path": "/v1/users/{user}/stats/{range}",
      "description": "WakaTime compat v1: get stats for a range"
    },
    {
      "method": "GET",
      "path": "/v1/users/{user}/stats",
      "description": "WakaTime compat v1: get stats (auto range)"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/stats/{range}",
      "description": "WakaTime compat v1: get stats for a range"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/stats",
      "description": "WakaTime compat v1: get stats (auto range)"
    },

    {
      "method": "GET",
      "path": "/users/{user}/summaries",
      "description": "WakaTime compat: get daily summaries"
    },
    {
      "method": "GET",
      "path": "/v1/users/{user}/summaries",
      "description": "WakaTime compat v1: get daily summaries"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/summaries",
      "description": "WakaTime compat v1: get daily summaries"
    },

    {
      "method": "GET",
      "path": "/users/{user}/all_time_since_today",
      "description": "WakaTime compat: all-time total"
    },
    {
      "method": "GET",
      "path": "/v1/users/{user}/all_time_since_today",
      "description": "WakaTime compat v1: all-time total"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/all_time_since_today",
      "description": "WakaTime compat v1: all-time total"
    },

    {
      "method": "GET",
      "path": "/users/{user}/projects",
      "description": "WakaTime compat: project list"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/projects",
      "description": "WakaTime compat v1: project list"
    },

    {
      "method": "GET",
      "path": "/users/{user}/statusbar/{range}",
      "description": "WakaTime compat: statusbar data"
    },
    {
      "method": "GET",
      "path": "/v1/users/{user}/statusbar/{range}",
      "description": "WakaTime compat v1: statusbar data"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/statusbar/{range}",
      "description": "WakaTime compat v1: statusbar data"
    },

    {
      "method": "GET",
      "path": "/users/{user}/user_agents",
      "description": "WakaTime compat: user agents"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/user_agents",
      "description": "WakaTime compat v1: user agents"
    },

    {
      "method": "GET",
      "path": "/users/{user}",
      "description": "WakaTime compat: user info"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}",
      "description": "WakaTime compat v1: user info"
    },

    {
      "method": "GET",
      "path": "/compat/wakatime/v1/users/{user}/heartbeats",
      "description": "WakaTime compat v1: get heartbeats for a date"
    },
    {
      "method": "GET",
      "path": "/compat/wakatime/v1/leaders",
      "description": "WakaTime compat v1: leaderboard"
    },

    {
      "method": "GET",
      "path": "/badge/{user}/{*rest}",
      "description": "SVG badge for coding time"
    },
    {
      "method": "GET",
      "path": "/compat/shields/v1/{user}/{interval}/{filter}",
      "description": "Shields.io JSON badge endpoint"
    }
  ],
  "ui_components": [
    {
      "id": "coding-dashboard",
      "name": "Coding Activity Dashboard",
      "mount_point": "Dashboard",
      "bundle_path": "ui/coding.js"
    },
    {
      "id": "coding-main",
      "name": "Coding Activity",
      "mount_point": "MainPage",
      "bundle_path": "ui/coding.js"
    }
  ],
  "capabilities": {
    "version": 1,
    "network_hosts": ["api.wakatime.com"],
    "field_read": ["*"],
    "field_write": ["coding:*", "system:node_time", "system:node_end_time"],
    "write_own_nodes": true,
    "app_managed_nodes": false,
    "file_read": false,
    "file_write": false,
    "execute": false,
    "dns_requests": true,
    "object_storage_read": false,
    "object_storage_write": false
  },
  "wasm_module": "plugin.wasm",
  "background_tasks": [
    {
      "name": "daily-summary-rollup",
      "interval_seconds": 3600,
      "description": "Roll up heartbeats into daily summary nodes for fast dashboard queries"
    }
  ],
  "env_vars": {}
}
