{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "panorama",
  "version": "0.1.0",
  "identifier": "io.mzhang.panorama",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "panorama",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' panorama-static: panorama-api:",
        "frame-src": "'self' panorama-static: panorama-api:",
        "connect-src": "'self' ws://localhost:* wss://localhost:* ws://journal:*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
