# Dockerfile.fuzz — AFL++ fuzzing environment for Panorama parsers (PromQL & PQL)
FROM aflplusplus/aflplusplus:latest

# Copy Rust toolchain from official rust image
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

COPY --from=rust:1.96 /usr/local/cargo /usr/local/cargo
COPY --from=rust:1.96 /usr/local/rustup /usr/local/rustup

# Install cargo-afl wrapper
RUN cargo install cargo-afl

WORKDIR /workspace

# Copy repository
COPY . .

# Build AFL++ instrumented fuzzing binaries
RUN cd fuzz && cargo afl build --release

# Script launcher entrypoint
ENTRYPOINT ["/bin/bash", "/workspace/scripts/run-fuzz.sh"]
